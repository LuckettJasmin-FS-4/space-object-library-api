<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport"
        content="width=device-width, initial-scale=1.0">
  <title>Space Library Tracker</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <header>
    <h1>🚀 Space Library Tracker</h1>
    <p>Explore and Manage the Universe</p>
  </header>

  <main>
    <h2>Mission Control Dashboard</h2>
    <p>Select a category to manage your space objects.</p>

    <div class="card-container">

      <a href="/galaxies" class="card">
        <h3>🌌 Galaxies</h3>
        <p>Create, view, edit, and delete galaxies.</p>
      </a>

      <a href="/stars" class="card">
        <h3>⭐ Stars</h3>
        <p>Manage stars throughout the universe.</p>
      </a>

      <a href="/planets" class="card">
        <h3>🪐 Planets</h3>
        <p>Explore and manage planets.</p>
      </a>

    </div>
  </main>

  <footer>
    <p>Space Library Tracker | Mission Control</p>
  </footer>

</body>
</html>