<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Star</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header><h1>⭐ Edit Star</h1></header>

  <main>
    <form action="/stars/<%= star.id %>?_method=PUT"
          method="POST"
          enctype="multipart/form-data">

      <p>
        <label for="name">Star Name</label>
        <input id="name" name="name" type="text"
               value="<%= star.name %>" required>
      </p>

      <p>
        <label for="size">Size</label>
        <input id="size" name="size" type="number" min="0"
               value="<%= star.size ?? '' %>">
      </p>

      <p>
        <label for="description">Description</label>
        <textarea id="description" name="description"><%= star.description ?? '' %></textarea>
      </p>

      <p>
        <label for="galaxyId">Galaxy</label>
        <select id="galaxyId" name="galaxyId">
          <option value="">Unassigned</option>
          <% galaxies.forEach(galaxy => { %>
            <option value="<%= galaxy.id %>"
              <%= star.galaxyId === galaxy.id ? 'selected' : '' %>>
              <%= galaxy.name %>
            </option>
          <% }) %>
        </select>
      </p>

      <% if (star.image) { %>
        <p>Current Image</p>
        <img src="<%= star.image %>"
             alt="<%= star.name %>"
             style="max-width:250px; border-radius:10px;">
      <% } %>

      <p>
        <label for="image">Upload New Image</label>
        <input id="image" type="file" name="image"
               accept="image/jpeg,image/png,image/webp">
      </p>

      <button type="submit">Save Changes</button>
    </form>

    <p><a href="/stars">← Back to Stars</a></p>
  </main>
</body>
</html>